roll_box.grid(row=1, column=1)

tkinter.Label(form_frame, text="Class:").grid(row=2, column=0, pady=5)
class_box = tkinter.Entry(form_frame)
class_box.grid(row=2, column=1)

tkinter.Label(form_frame, text="Sub 1:").grid(row=3, column=0)
sub1_box = tkinter.Entry(form_frame); sub1_box.grid(row=3, column=1)
tkinter.Label(form_frame, text="Sub 2:").grid(row=4, column=0)
sub2_box = tkinter.Entry(form_frame); sub2_box.grid(row=4, column=1)
tkinter.Label(form_frame, text="Sub 3:").grid(row=5, column=0)
sub3_box = tkinter.Entry(form_frame); sub3_box.grid(row=5, column=1)
tkinter.Label(form_frame, text="Sub 4:").grid(row=6, column=0)
sub4_box = tkinter.Entry(form_frame); sub4_box.grid(row=6, column=1)
tkinter.Label(form_frame, text="Sub 5:").grid(row=7, column=0)
sub5_box = tkinter.Entry(form_frame); sub5_box.grid(row=7, column=1)

# The 3 Buttons[span_9](start_span)[span_9](end_span)
btn_frame = tkinter.Frame(form_frame)
btn_frame.grid(row=8, column=0, columnspan=2, pady=20)

tkinter.Button(btn_frame, text="Save", command=save_to_spreadsheet, bg="lightgreen").pack(side="left", padx=5)
tkinter.Button(btn_frame, text="Get Result", command=get_result, bg="lightyellow").pack(side="left", padx=5)
tkinter.Button(btn_frame, text="All Results", command=show_all_tabular, bg="lightblue").pack(side="left", padx=5)

root.mainloop()

